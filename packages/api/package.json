{
  "name": "@orcy/api",
  "version": "1.0.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "orcy-api": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist/test && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run --exclude src/test/perfWorkflow.test.ts --exclude src/test/stagedEnforcementOverlap.test.ts --exclude src/test/perfNotificationDeliveryQuery.test.ts --exclude src/test/extractionRerunConcurrency.test.ts",
    "test:watch": "vitest --exclude src/test/perfNotificationDeliveryQuery.test.ts",
    "test:perf": "vitest run src/test/perfWorkflow.test.ts --fileParallelism=false",
    "test:staged-overlap": "vitest run src/test/stagedEnforcementOverlap.test.ts",
    "test:production-migration": "vitest run src/test/migrationCompletenessGuard.test.ts src/test/enumCheckConstraints.test.ts src/test/productionMigrationChain.test.ts src/test/f3QuarantineResetFreeze.test.ts src/test/pluginQuarantineProductionMigration.test.ts src/test/compiledStartup.test.ts src/test/webhookRetryBootSmoke.test.ts",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx ../../scripts/seed.ts",
    "test:notification-query-work": "vitest run src/test/perfNotificationDeliveryQuery.test.ts --maxWorkers=1 --no-file-parallelism",
    "test:extraction-concurrency": "vitest run src/test/extractionRerunConcurrency.test.ts --fileParallelism=false"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.2",
    "@orcy/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "cron-parser": "^5.10.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-raw-body": "^6.0.3",
    "fastify-type-provider-zod": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.1",
    "pino": "^9.0.0",
    "undici": "^8.13.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@orcy/daemon": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^11.0.0",
    "sql.js": "^1.17.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
