{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-async-endpoint-handlers": "off",
    "no-underscore-dangle": "off",
    "unicorn/no-array-sort": "off"
  },
  "overrides": [
    {
      "files": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "**/src/test/fixtures/**"
      ],
      "rules": {
        "no-unused-vars": "off",
        "unicorn/consistent-function-scoping": "off",
        "no-shadow": "off"
      }
    },
    {
      "files": [
        "**/services/inlineScheduledOccurrencePublication.ts"
      ],
      "rules": {
        "no-shadow": "off"
      }
    },
    {
      "files": [
        "**/repositories/notificationDelivery.ts"
      ],
      "rules": {
        "no-shadow": "off"
      }
    }
  ]
}
